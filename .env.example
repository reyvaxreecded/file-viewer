# Copy to /etc/glassftp/glassftp.env (root:glassftp, 0640). Never commit secrets.
APP_HOST=127.0.0.1
APP_PORT=8080
APP_BASE_URL=https://glassftp.lan
ASSET_DIRECTORY=/opt/glassftp/dist
DATABASE_PATH=/var/lib/glassftp/metadata.sqlite
SFTP_HOST=127.0.0.1
SFTP_PORT=22
SFTP_USERNAME=glassftp-sftp
SFTP_PASSWORD_FILE=/etc/glassftp/sftp-password
# Alternative: SFTP_PASSWORD, only in a protected environment. No default password.
SFTP_ROOT=/shared
# Obtain on the Debian host itself: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub -E sha256
SFTP_HOST_KEY_SHA256=SHA256:REPLACE_WITH_VERIFIED_HOST_FINGERPRINT
SFTP_MAX_CONNECTIONS=6
SFTP_TIMEOUT_SECONDS=30
MAX_CONCURRENT_TRANSFERS=4
# Bytes; default 100 GiB per file. HTTP fragments are limited to 8 MiB.
MAX_UPLOAD_SIZE=107374182400
RUST_LOG=glassftp_server=info
# Internal directories are fixed: SFTP_ROOT/.glassftp/{uploads,trash}.
# Keeping them on the same filesystem permits atomic finalization.
